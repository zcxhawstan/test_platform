# Django 核心配置（生产：DEBUG=False）
DEBUG=False
SECRET_KEY=please-change-this-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# MySQL（compose 内自动注入 DB_HOST/PORT，这里只留库名账号密码可改）
MYSQL_DATABASE=test_platform
MYSQL_USER=tpuser
MYSQL_PASSWORD=TpUser@2026
MYSQL_ROOT_PASSWORD=Root@2026

# Redis（compose 内自动注入 REDIS_HOST/PORT）
REDIS_PASSWORD=

# Celery（走容器网络 redis:6379）
REDIS_DB_CACHE=0
REDIS_DB_BROKER=1
REDIS_DB_RESULT=2

# 敏感字段加密密钥（Fernet，丢失=所有已存密码无法解密）
ENCRYPTION_KEY=please-change-this-to-a-fernet-key

# 初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
ADMIN_EMAIL=admin@example.com

# 对外端口（宿主机侧）
WEB_PORT=8000
