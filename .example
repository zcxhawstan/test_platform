# ============================================
# 测试平台环境配置文件示例
# 复制此文件为 .env 并修改配置后启动服务
# ============================================

# ============================================
# Django 安全密钥
# DEBUG=False 时必填，缺失将拒绝启动
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ============================================
SECRET_KEY=change-me-to-a-random-50-char-string

# ============================================
# Django 调试模式 (生产环境必须设置为False)
# DEBUG=False 时 SECRET_KEY 和 ALLOWED_HOSTS 必填且不允许通配
# ============================================
DEBUG=True

# ============================================
# 允许访问的主机 (多个用逗号分隔，禁止 * )
# ============================================
ALLOWED_HOSTS=localhost,127.0.0.1,your_server_host

# ============================================
# CORS 白名单 (多个用逗号分隔)
# 未配置时默认只放行本机开发前端 http://localhost:5173
# 生产环境必须配置为实际前端域名
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ============================================
# 敏感字段加密密钥 (Fernet格式，必填)
# 用于执行机SSH密码等敏感字段的加密存储
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意: 丢失此密钥将无法解密已存储的密码
# ============================================
ENCRYPTION_KEY=generate-a-fernet-key-and-paste-here

# ============================================
# Django 数据库配置 (MySQL)
# ============================================
DB_ENGINE=django.db.backends.mysql
DB_NAME=test_platform
DB_USER=root
DB_PASSWORD=your_db_password
DB_HOST=your_mysql_host
DB_PORT=3306

# ============================================
# Redis 配置 (用于Celery和缓存)
# ============================================
REDIS_HOST=your_redis_host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery 配置 (使用上面的Redis配置)
# 资源隔离配置：
# DB 0: Django 缓存 (Cache)
# DB 1: Celery 消息代理 (Broker)
# DB 2: Celery 结果后端 (Result Backend)
CELERY_BROKER_URL=redis://your_redis_host:6379/1
CELERY_RESULT_BACKEND=redis://your_redis_host:6379/2

# ============================================
# 管理员账号配置 (首次初始化时使用)
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
